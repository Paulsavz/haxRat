# ─────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────
# Project URL from Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/public key — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key — NEVER expose to the browser; server-side only
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT secret (Settings → API → JWT Settings)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ─────────────────────────────────────────────────────────────
# Daily.co (Video / Audio Calls)
# ─────────────────────────────────────────────────────────────
# API key from dashboard.daily.co → Developers
DAILY_API_KEY=your-daily-api-key

# Base URL for Daily REST API (rarely needs changing)
DAILY_API_BASE_URL=https://api.daily.co/v1

# Your Daily.co domain (e.g. myapp.daily.co)
DAILY_DOMAIN=your-domain.daily.co

# ─────────────────────────────────────────────────────────────
# Paystack (Payments)
# ─────────────────────────────────────────────────────────────
# Public key — safe to expose in the browser
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret key — server-side only
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook secret for verifying Paystack webhook payloads
PAYSTACK_WEBHOOK_SECRET=your-paystack-webhook-secret

# ─────────────────────────────────────────────────────────────
# Firebase Cloud Messaging (Push Notifications)
# ─────────────────────────────────────────────────────────────
# Legacy FCM server key (for direct HTTP API)
FCM_SERVER_KEY=your-fcm-server-key

# Firebase project ID
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase service account JSON (stringified) for Admin SDK
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# ─────────────────────────────────────────────────────────────
# App URLs
# ─────────────────────────────────────────────────────────────
# Public-facing storefront / customer app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin dashboard URL
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# API / backend base URL (used by server-side code and mobile apps)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ─────────────────────────────────────────────────────────────
# General App Config
# ─────────────────────────────────────────────────────────────
NODE_ENV=development

# Secret used for signing session cookies / JWTs (min 32 chars)
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Default store currency code
STORE_CURRENCY=GHS

# Comma-separated list of admin email addresses (bootstrap only)
ADMIN_EMAILS=admin@retailhub.com

# ─────────────────────────────────────────────────────────────
# Admin Dashboard (Vite — prefix all with VITE_)
# ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_URL=http://localhost:4000/api

# ─────────────────────────────────────────────────────────────
# Backend (Node.js — no prefix required)
# ─────────────────────────────────────────────────────────────
PORT=4000
SUPABASE_URL=https://your-project-ref.supabase.co
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
